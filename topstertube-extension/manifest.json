{
   "background": {
      "service_worker": "background.js"
   },
   "description": "클래식 탑스터 및 그리드 레이아웃을 생성하고, 유튜브 음악을 즉시 감상할 수 있는 기능을 제공합니다.",
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Topstertube - 재생 가능한 탑스터",
   "action": {
      "default_title": "Topstertube 열기",
      "default_icon": {
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      }
   },
   "permissions": [ "sidePanel", "tabs", "storage", "activeTab", "scripting", "downloads" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.3"
}
